{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Registered FabriQ AI user profile and membership",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 20 },
        "address": { "type": "string", "maxLength": 300 },
        "loyaltyPoints": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "name", "email"]
    },
    "Order": {
      "title": "Garment Care Order",
      "description": "FabriQ AI garment care booking with tracking status",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "branchId": { "type": "string" },
        "serviceName": { "type": "string" },
        "status": { "type": "string" },
        "totalAmount": { "type": "number" },
        "items": { "type": "string", "maxLength": 2000 },
        "pickupSlot": { "type": "string" },
        "deliverySlot": { "type": "string" },
        "address": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "paymentStatus": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "status", "totalAmount"]
    },
    "Notification": {
      "title": "Notification",
      "description": "In-app and FCM push notification alert",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "title", "body"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Garment care orders"
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "Push notification logs"
    }
  }
}
