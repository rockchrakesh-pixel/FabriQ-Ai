  "firestore": {
    "/catalog_images/{imageId}": {
      "schema": { "$ref": "#/entities/CatalogImage" },
      "description": "High-definition catalog imagery and garment graphics"
    },
    "/idempotency_records/{key}": {
      "schema": { "$ref": "#/entities/IdempotencyRecord" },
      "description": "Distributed persistent idempotency records"
    },
    "/organizations/{orgId}": {
      "schema": { "$ref": "#/entities/Organization" },
      "description": "Master organization records"
    },
    "/organizations/{orgId}/divisions/{divisionId}": {
      "schema": { "$ref": "#/entities/Division" },
      "description": "Divisions within an organization"
    },
    "/organizations/{orgId}/franchises/{franchiseId}": {
      "schema": { "$ref": "#/entities/Franchise" },
      "description": "Franchise entities"
    },
