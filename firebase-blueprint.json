    },
    "/idempotency_records/{idempotencyKey}": {
      "schema": { "$ref": "#/entities/IdempotencyRecord" },
      "description": "Persistent distributed idempotency locks & cached request replays"
    },
    "/tax_classifications/{classificationId}": {
      "schema": { "$ref": "#/entities/TaxClassification" },
      "description": "Master HSN and SAC tax codes"
    },
    "/tax_schedules/{taxScheduleId}": {
      "schema": { "$ref": "#/entities/TaxSchedule" },
      "description": "Versioned HSN/SAC tax schedules and effective date rules"
    },
    "/tax_audit_records/{auditId}": {
      "schema": { "$ref": "#/entities/TaxAuditRecord" },
      "description": "Append-only tax configuration audit trail"
    },
    "/customer_measurements/{measurementProfileId}": {
      "read": "isAuthenticated() && (resource.data.customerId == request.auth.uid || isStaffOrAdmin())",
      "write": "isAuthenticated() && (request.resource.data.customerId == request.auth.uid || isStaffOrAdmin())",
      "schema": {
        "measurementProfileId": "string",
        "customerId": "string",
        "orgId": "string",
        "profileName": "string",
        "measurementVersion": "number",
        "measurements": "object",
        "notes": "string?",
        "updatedAt": "string"
      },
      "description": "Versioned bespoke tailoring customer measurement profiles"
    },
    "/order_inventory_requirements/{requirementId}": {
      "read": "isAuthenticated() && (isStaffOrAdmin())",
      "write": "isAuthenticated() && (isStaffOrAdmin())",
      "schema": {
        "requirementId": "string",
        "orderId": "string",
        "itemId": "string",
        "sku": "string",
        "itemName": "string",
        "orgId": "string",
        "divisionId": "string",
        "requiredQuantity": "number",
